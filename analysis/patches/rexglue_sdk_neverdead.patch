diff --git a/tests/unit/graphics/texture_descriptor_test.cpp b/tests/unit/graphics/texture_descriptor_test.cpp
new file mode 100644
index 0000000..c1ed3c6
--- /dev/null
+++ b/tests/unit/graphics/texture_descriptor_test.cpp
@@ -0,0 +1,134 @@
+/**
+ * @file        tests/unit/graphics/texture_descriptor_test.cpp
+ * @brief       Unit tests for Xbox 360 texture fetch constant decoding and Asura HDR RT validation
+ *
+ * @copyright   Copyright (c) 2026 NeverDead Native PC Port Team
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/graphics/xenos.h>
+
+using namespace rex::graphics;
+using namespace rex::graphics::texture_util;
+
+TEST_CASE("Asura Engine 1120x640 HDR Float render targets are validated correctly", "[graphics][texture]") {
+  SECTION("Primary Scene Buffer: 1120x640 k_16_16_16_16_FLOAT (0x20)") {
+    // Descriptor observed in NeverDead run 613:
+    // (88C04954 1F318060 004FE45F 00A80D11 00000003 00000200)
+    xenos::xe_gpu_texture_fetch_t fetch;
+    fetch.dword_0 = 0x88C04954;
+    fetch.dword_1 = 0x1F318060;
+    fetch.dword_2 = 0x004FE45F;
+    fetch.dword_3 = 0x00A80D11;
+    fetch.dword_4 = 0x00000003;
+    fetch.dword_5 = 0x00000200;
+
+    // Verify raw bitfield decoding
+    CHECK(fetch.type == xenos::FetchConstantType::kInvalidTexture);
+    CHECK(fetch.tiled == 1);
+    CHECK(fetch.format == xenos::TextureFormat::k_16_16_16_16_FLOAT);
+    CHECK(fetch.base_address == 0x1F318);
+
+    uint32_t width_minus_1 = 0, height_minus_1 = 0, depth_or_array_minus_1 = 0;
+    uint32_t base_page = 0, mip_page = 0, mip_max_level = 0;
+    GetSubresourcesFromFetchConstant(fetch, &width_minus_1, &height_minus_1,
+                                   &depth_or_array_minus_1, &base_page,
+                                   &mip_page, nullptr, &mip_max_level);
+
+    CHECK(width_minus_1 == 1119); // 1120 width
+    CHECK(height_minus_1 == 639); // 640 height
+    CHECK(base_page == 0x1F318);
+
+    // Targeted validation rule must accept this HDR RT
+    CHECK(IsValidHdrRenderTargetDescriptor(fetch, base_page, width_minus_1, height_minus_1));
+  }
+
+  SECTION("Secondary HDR Buffer: 1120x640 k_16_16_FLOAT (0x1F)") {
+    // Descriptor observed in NeverDead run 613:
+    // (88C04954 1E82809F 004FE45F 00801691 00000000 00000200)
+    xenos::xe_gpu_texture_fetch_t fetch;
+    fetch.dword_0 = 0x88C04954;
+    fetch.dword_1 = 0x1E82809F;
+    fetch.dword_2 = 0x004FE45F;
+    fetch.dword_3 = 0x00801691;
+    fetch.dword_4 = 0x00000000;
+    fetch.dword_5 = 0x00000200;
+
+    CHECK(fetch.type == xenos::FetchConstantType::kInvalidTexture);
+    CHECK(fetch.tiled == 1);
+    CHECK(fetch.format == xenos::TextureFormat::k_16_16_FLOAT);
+    CHECK(fetch.base_address == 0x1E828);
+
+    uint32_t width_minus_1 = 0, height_minus_1 = 0, depth_or_array_minus_1 = 0;
+    uint32_t base_page = 0, mip_page = 0, mip_max_level = 0;
+    GetSubresourcesFromFetchConstant(fetch, &width_minus_1, &height_minus_1,
+                                   &depth_or_array_minus_1, &base_page,
+                                   &mip_page, nullptr, &mip_max_level);
+
+    CHECK(width_minus_1 == 1119);
+    CHECK(height_minus_1 == 639);
+    CHECK(base_page == 0x1E828);
+
+    CHECK(IsValidHdrRenderTargetDescriptor(fetch, base_page, width_minus_1, height_minus_1));
+  }
+
+  SECTION("Unbound Register (Zero Address & Mip): Must be rejected") {
+    // Descriptor observed in NeverDead run 613:
+    // (00000000 00000000 00000000 00A80000 00000003 00000000)
+    xenos::xe_gpu_texture_fetch_t fetch;
+    fetch.dword_0 = 0x00000000;
+    fetch.dword_1 = 0x00000000;
+    fetch.dword_2 = 0x00000000;
+    fetch.dword_3 = 0x00A80000;
+    fetch.dword_4 = 0x00000003;
+    fetch.dword_5 = 0x00000000;
+
+    uint32_t width_minus_1 = 0, height_minus_1 = 0, depth_or_array_minus_1 = 0;
+    uint32_t base_page = 0, mip_page = 0, mip_max_level = 0;
+    GetSubresourcesFromFetchConstant(fetch, &width_minus_1, &height_minus_1,
+                                   &depth_or_array_minus_1, &base_page,
+                                   &mip_page, nullptr, &mip_max_level);
+
+    CHECK(base_page == 0);
+    CHECK(mip_page == 0);
+    // Unbound slot must NOT be accepted as valid HDR RT
+    CHECK_FALSE(IsValidHdrRenderTargetDescriptor(fetch, base_page, width_minus_1, height_minus_1));
+  }
+
+  SECTION("Garbage / Non-HDR Format with kInvalidTexture: Must be rejected") {
+    xenos::xe_gpu_texture_fetch_t fetch;
+    fetch.dword_0 = 0x88C04954;
+    fetch.dword_1 = 0x1F318006; // format = k_8_8_8_8 (6)
+    fetch.dword_2 = 0x004FE45F;
+    fetch.dword_3 = 0x00A80D11;
+    fetch.dword_4 = 0x00000003;
+    fetch.dword_5 = 0x00000200;
+
+    uint32_t width_minus_1 = 1119, height_minus_1 = 639;
+    uint32_t base_page = 0x1F318;
+
+    // Non-HDR format with invalid type must NOT be accepted
+    CHECK_FALSE(IsValidHdrRenderTargetDescriptor(fetch, base_page, width_minus_1, height_minus_1));
+  }
+
+  SECTION("Linear texture with kInvalidTexture: Must be rejected") {
+    xenos::xe_gpu_texture_fetch_t fetch;
+    fetch.dword_0 = 0x08C04954; // tiled = 0
+    fetch.dword_1 = 0x1F318060; // format = k_16_16_16_16_FLOAT
+    fetch.dword_2 = 0x004FE45F;
+    fetch.dword_3 = 0x00A80D11;
+    fetch.dword_4 = 0x00000003;
+    fetch.dword_5 = 0x00000200;
+
+    uint32_t width_minus_1 = 1119, height_minus_1 = 639;
+    uint32_t base_page = 0x1F318;
+
+    // Linear surface with invalid type must NOT be accepted
+    CHECK_FALSE(IsValidHdrRenderTargetDescriptor(fetch, base_page, width_minus_1, height_minus_1));
+  }
+}
