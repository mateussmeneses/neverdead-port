+  constexpr std::array<uint8_t, 4> signature = {0x0F, 0xF5, 0x12, 0xED};
+  constexpr std::array<uint8_t, 4> plain_file = {0x00, 0x00, 0x00, 0x00};
+  constexpr std::array<uint8_t, 3> short_header = {0x0F, 0xF5, 0x12};
+
+  CHECK(IsXctdCompressedHeader(signature));
+  CHECK_FALSE(IsXctdCompressedHeader(plain_file));
+  CHECK_FALSE(IsXctdCompressedHeader(short_header));
+}
