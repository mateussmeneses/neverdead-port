diff --git a/tests/unit/system/file_info_test.cpp b/tests/unit/system/file_info_test.cpp
new file mode 100644
index 0000000..c423c1f
--- /dev/null
+++ b/tests/unit/system/file_info_test.cpp
@@ -0,0 +1,28 @@
+/**
+ * @file        tests/unit/system/file_info_test.cpp
+ * @brief       Unit tests for Xbox 360 file information
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <array>
+#include <cstdint>
+
+#include <catch2/catch_test_macros.hpp>
+#include <rex/system/info/file.h>
+
+using rex::system::IsXctdCompressedHeader;
+
+TEST_CASE("XCTD header detection uses the big-endian file signature", "[system][file]") {
+  constexpr std::array<uint8_t, 4> signature = {0x0F, 0xF5, 0x12, 0xED};
+  constexpr std::array<uint8_t, 4> plain_file = {0x00, 0x00, 0x00, 0x00};
+  constexpr std::array<uint8_t, 3> short_header = {0x0F, 0xF5, 0x12};
+
+  CHECK(IsXctdCompressedHeader(signature));
+  CHECK_FALSE(IsXctdCompressedHeader(plain_file));
+  CHECK_FALSE(IsXctdCompressedHeader(short_header));
+}
diff --git a/tests/unit/system/sync_primitives_test.cpp b/tests/unit/system/sync_primitives_test.cpp
new file mode 100644
index 0000000..074c13f
--- /dev/null
+++ b/tests/unit/system/sync_primitives_test.cpp
@@ -0,0 +1,60 @@
+/**
+ * @file        tests/unit/system/sync_primitives_test.cpp
+ * @brief       Unit tests for guest synchronization primitives
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <chrono>
+
+#include <catch2/catch_test_macros.hpp>
+#include <rex/thread.h>
+
+using rex::thread::Event;
+using rex::thread::Mutant;
+using rex::thread::Timer;
+using rex::thread::Wait;
+using rex::thread::WaitResult;
+
+TEST_CASE("Manual-reset event stays signaled until reset", "[thread][sync]") {
+  auto event = Event::CreateManualResetEvent(false);
+  REQUIRE(event);
+
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+  event->Set();
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  event->Reset();
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
+
+TEST_CASE("Auto-reset event releases only one wait", "[thread][sync]") {
+  auto event = Event::CreateAutoResetEvent(true);
+  REQUIRE(event);
+
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
+
+TEST_CASE("Released mutant can be acquired again", "[thread][sync]") {
+  auto mutant = Mutant::Create(false);
+  REQUIRE(mutant);
+
+  CHECK(Wait(mutant.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(mutant->Release());
+  CHECK(Wait(mutant.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(mutant->Release());
+}
+
+TEST_CASE("Synchronization timer signals once after its due time", "[thread][sync]") {
+  auto timer = Timer::CreateSynchronizationTimer();
+  REQUIRE(timer);
+
+  REQUIRE(timer->SetOnceAfter(rex::chrono::hundrednanoseconds{100'000}));
+  CHECK(Wait(timer.get(), false, std::chrono::seconds{1}) == WaitResult::kSuccess);
+  CHECK(Wait(timer.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
