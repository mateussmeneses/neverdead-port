+
+#include <chrono>
+
+#include <catch2/catch_test_macros.hpp>
+#include <rex/thread.h>
+
+using rex::thread::Event;
+using rex::thread::Mutant;
+using rex::thread::Timer;
+using rex::thread::Wait;
+using rex::thread::WaitResult;
+
+TEST_CASE("Manual-reset event stays signaled until reset", "[thread][sync]") {
+  auto event = Event::CreateManualResetEvent(false);
+  REQUIRE(event);
+
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+  event->Set();
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  event->Reset();
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
+
+TEST_CASE("Auto-reset event releases only one wait", "[thread][sync]") {
+  auto event = Event::CreateAutoResetEvent(true);
+  REQUIRE(event);
+
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(Wait(event.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
+
+TEST_CASE("Released mutant can be acquired again", "[thread][sync]") {
+  auto mutant = Mutant::Create(false);
+  REQUIRE(mutant);
+
+  CHECK(Wait(mutant.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(mutant->Release());
+  CHECK(Wait(mutant.get(), false, std::chrono::milliseconds{0}) == WaitResult::kSuccess);
+  CHECK(mutant->Release());
+}
+
+TEST_CASE("Synchronization timer signals once after its due time", "[thread][sync]") {
+  auto timer = Timer::CreateSynchronizationTimer();
+  REQUIRE(timer);
+
+  REQUIRE(timer->SetOnceAfter(rex::chrono::hundrednanoseconds{100'000}));
+  CHECK(Wait(timer.get(), false, std::chrono::seconds{1}) == WaitResult::kSuccess);
+  CHECK(Wait(timer.get(), false, std::chrono::milliseconds{0}) == WaitResult::kTimeout);
+}
